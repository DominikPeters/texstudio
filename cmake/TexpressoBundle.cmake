# A developer supplies a complete engine bundle; users receive it inside the app.
option(TEXSTUDIO_ENABLE_TEXPRESSO "Bundle TeXpresso and enable live preview" ON)
if(NOT TEXSTUDIO_ENABLE_TEXPRESSO)
    return()
endif()
if(NOT APPLE AND NOT CMAKE_SYSTEM_NAME STREQUAL "Linux")
    message(FATAL_ERROR "Live preview currently supports macOS and Linux. Use -DTEXSTUDIO_ENABLE_TEXPRESSO=OFF on other platforms.")
endif()
if(APPLE)
    set(_txp_platform darwin)
else()
    set(_txp_platform linux)
endif()
set(_txp_arch "${CMAKE_SYSTEM_PROCESSOR}")
if(APPLE AND CMAKE_OSX_ARCHITECTURES)
    set(_txp_arch "${CMAKE_OSX_ARCHITECTURES}")
endif()
set(TEXPRESSO_BUNDLE_DIR "${PROJECT_SOURCE_DIR}/native/.bundles/${_txp_platform}-${_txp_arch}" CACHE PATH "Complete, pinned TeXpresso runtime bundle")
find_package(Python3 3.12 COMPONENTS Interpreter REQUIRED)
execute_process(COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/native/scripts/validate_bundle.py"
    "${TEXPRESSO_BUNDLE_DIR}" --platform "${_txp_platform}" --architecture "${_txp_arch}"
    RESULT_VARIABLE _txp_validation OUTPUT_VARIABLE _txp_output ERROR_VARIABLE _txp_error)
if(NOT _txp_validation EQUAL 0)
    message(FATAL_ERROR "A matching TeXpresso bundle is required. See native/README.md.\n${_txp_error}")
endif()
message(STATUS "${_txp_output}")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${TEXPRESSO_BUNDLE_DIR}/build-manifest.json")

function(texstudio_bundle_texpresso)
    if(APPLE)
        set(_destination "$<TARGET_BUNDLE_DIR:texstudio>/Contents/Helpers/texpresso")
        install(DIRECTORY "${TEXPRESSO_BUNDLE_DIR}/" DESTINATION "${CMAKE_INSTALL_BINDIR}/texstudio.app/Contents/Helpers/texpresso" USE_SOURCE_PERMISSIONS)
    else()
        set(_destination "$<TARGET_FILE_DIR:texstudio>/texpresso-runtime")
        install(DIRECTORY "${TEXPRESSO_BUNDLE_DIR}/" DESTINATION "${CMAKE_INSTALL_LIBEXECDIR}/texstudio/texpresso" USE_SOURCE_PERMISSIONS)
    endif()
    add_custom_target(texpresso_bundle ALL
        COMMAND "${CMAKE_COMMAND}" -E copy_directory "${TEXPRESSO_BUNDLE_DIR}" "${_destination}"
        COMMENT "Staging bundled TeXpresso runtime")
    add_dependencies(texpresso_bundle texstudio)
endfunction()
