option(TEXSTUDIO_COMPRESS_DICTIONARIES "Store bundled dictionaries as lazy-loaded ZIP archives" ON)
file(GLOB _dictionary_inputs "${PROJECT_SOURCE_DIR}/utilities/dictionaries/*")
if(TEXSTUDIO_COMPRESS_DICTIONARIES)
    find_package(Python3 COMPONENTS Interpreter REQUIRED)
    set(_dictionary_output "${PROJECT_BINARY_DIR}/dictionaries")
    set(TEXSTUDIO_DICTIONARY_FILES)
    foreach(_input IN LISTS _dictionary_inputs)
        get_filename_component(_name "${_input}" NAME)
        if(_name MATCHES "\\.(aff|idx)$")
            string(REGEX REPLACE "\\.(aff|idx)$" "" _base "${_input}")
            if(EXISTS "${_base}.dic" OR EXISTS "${_base}.dat")
                continue()
            endif()
        endif()
        if(_name MATCHES "\\.(dic|dat)$")
            string(APPEND _name ".zip")
        endif()
        list(APPEND TEXSTUDIO_DICTIONARY_FILES "${_dictionary_output}/${_name}")
    endforeach()
    add_custom_command(OUTPUT ${TEXSTUDIO_DICTIONARY_FILES}
        COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/native/scripts/pack_dictionaries.py"
            --source "${PROJECT_SOURCE_DIR}/utilities/dictionaries" --output "${_dictionary_output}"
        DEPENDS ${_dictionary_inputs} "${PROJECT_SOURCE_DIR}/native/scripts/pack_dictionaries.py"
        COMMENT "Compressing bundled dictionaries")
    add_custom_target(dictionary_archives DEPENDS ${TEXSTUDIO_DICTIONARY_FILES})
    set_source_files_properties(${TEXSTUDIO_DICTIONARY_FILES} PROPERTIES GENERATED TRUE)
else()
    set(TEXSTUDIO_DICTIONARY_FILES ${_dictionary_inputs})
endif()
